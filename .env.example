# API listening port (1-65535)
PORT=3001

# Comma-separated browser origins; use exact origins without paths or trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum score submissions per client IP in a rolling 60-second window.
RATE_LIMIT=30

# Optional persistence path. Relative paths resolve from the process working directory.
# DATA_FILE=backend/data/leaderboard.json
